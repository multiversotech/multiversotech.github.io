{
  "name": "multiversotech.github.io",
  "version": "1.0.0",
  "description": "Plataforma open-source de conhecimento tech para a comunidade brasileira",
  "main": "main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multiversotech/multiversotech.github.io.git"
  },
  "keywords": [
    "technology",
    "programming",
    "glossary",
    "english",
    "portuguese",
    "education",
    "tech",
    "brazilian",
    "open-source"
  ],
  "author": "Multiverso Tech Community",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/multiversotech/multiversotech.github.io/issues"
  },
  "homepage": "https://mutiversotech.github.io",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "stylelint": "stylelint **/*.css --fix",
    "sass:build": "sass src/scss/core-main.scss dist/css/core-main.min.css --style=compressed",
    "sass:compile": "sass src/scss/core-main.scss dist/css/core-main.css",
    "p:write": "npx prettier --write .",
    "p:check": "npx prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "sass --watch src/scss:dist/css/",
    "changelog": "node scripts/update-changelog.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "fs-extra": "^11.3.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.0",
    "@eslint/markdown": "^7.5.1",
    "ajv": "^6.14.0",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "prettier": "3.8.1",
    "sass": "^1.97.3",
    "stylelint": "^17.1.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    }
  }
}
